# ---------------------------------------------------------------- SwiftSearch
# Backend configuration. Copy to `.env` (repo root) or `backend/.env`.
#
# Every value is optional: with no configuration at all the app runs against
# local JSON storage with the demo corpus, which is what you want locally.
# The "PRODUCTION" notes below mark the ones that matter once deployed.
#
# The frontend is configured separately at build time —
# see frontend/.env.production.example.

# ----------------------------------------------------------------- Supabase
# Leave blank to use local JSON storage. The service key is read by the FastAPI
# backend only and is never exposed to the browser or included in any response.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_BUCKET=swiftsearch-documents

# ------------------------------------------------------------------ Backend
# Comma-separated list of browser origins allowed to call this API.
# PRODUCTION: must include your deployed frontend, e.g.
#   CORS_ORIGINS=https://swiftsearch.vercel.app
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Shared secret required by the destructive endpoints: document delete,
# index reset and demo seed. Empty means unprotected, which is fine locally.
# PRODUCTION: set this on any internet-facing deployment. Generate one with
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# Paste the same value into the app under Settings -> Admin access.
ADMIN_TOKEN=

# Load the bundled six-document demo corpus when the store is empty.
# PRODUCTION: set to false, or the first boot writes demo documents into your
# real Supabase project.
SEED_DEMO_DOCUMENTS=true

# The inverted index lives on local disk, which most hosting platforms wipe on
# every deploy and cold start. When an instance starts with documents but no
# index, rebuild it in the background from the text stored in Supabase.
# Leave true unless you want to control indexing manually.
AUTO_REBUILD_INDEX=true

# ---------------------------------------------------------- BSBI parameters
# Postings held in memory before a block is flushed to disk. Kept small by
# default so the demo corpus produces several blocks and the flush/sort/merge
# cycle is visible. Raise it for real corpora — the index is identical either
# way, only the number of blocks changes.
# PRODUCTION: 10000 is a reasonable starting point.
BLOCK_SIZE=250

# Converted into a block-size ceiling (bytes / 120 per posting). A real
# constraint: lowering it produces more, smaller blocks.
MAX_MEMORY_MB=512

LANGUAGE=english
USE_STOP_WORDS=true
USE_STEMMING=true

# ---------------------------------------------------------------- BM25
BM25_K1=1.2
BM25_B=0.75

# Seconds of pacing between pipeline steps so indexing is watchable in the UI.
# PRODUCTION: set to 0. At the default 0.12 an index build spends ~19 seconds
# per 100 documents doing nothing but sleeping.
INDEX_STEP_DELAY=0.12
