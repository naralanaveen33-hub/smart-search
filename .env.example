# ---------------------------------------------------------------- SwiftSearch
# Copy to `.env` (repo root) or `backend/.env`. Every value below is optional —
# with no configuration at all the app runs against local JSON storage.

# ----------------------------------------------------------------- Supabase
# Leave blank to use local storage. The service key is read by the FastAPI
# backend only and is never exposed to the browser.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_BUCKET=swiftsearch-documents

# ------------------------------------------------------------------ Backend
# Comma-separated list of allowed browser origins.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---------------------------------------------------------- BSBI parameters
# Postings held in memory before a block is flushed to disk. Kept small by
# default so the demo corpus produces several blocks and the flush/sort/merge
# cycle is visible. Raise it for real corpora — the index is identical either
# way, only the number of blocks changes.
BLOCK_SIZE=250
# Converted into a block-size ceiling (bytes / 120 per posting). A real
# constraint: lowering it produces more, smaller blocks.
MAX_MEMORY_MB=512
LANGUAGE=english
USE_STOP_WORDS=true
USE_STEMMING=true

# ---------------------------------------------------------------- BM25
BM25_K1=1.2
BM25_B=0.75

# Seconds of pacing between pipeline steps so indexing is watchable.
# Set to 0 for maximum throughput.
INDEX_STEP_DELAY=0.12

# ----------------------------------------------------------------- Frontend
# Only needed if the frontend is served separately from the Vite dev proxy.
# VITE_API_URL=http://127.0.0.1:8000/api
