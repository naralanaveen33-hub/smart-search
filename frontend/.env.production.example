# Frontend build-time configuration.
#
# Vite inlines VITE_* variables into the bundle AT BUILD TIME. Setting this
# after deploying has no effect — you must rebuild.
#
# On Vercel: Project -> Settings -> Environment Variables -> add for Production
# (and Preview), then redeploy.
#
# Without it the bundle falls back to a relative "/api", which resolves to the
# static host rather than your backend and returns 404 for every request. That
# fallback is only correct for local development, where the Vite dev server
# proxies /api to http://127.0.0.1:8000.
#
# Include the /api suffix. No trailing slash.

VITE_API_URL=https://swiftsearch-api.onrender.com/api
